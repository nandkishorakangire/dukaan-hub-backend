# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Supabase users: append ?pgbouncer=true for pooled connections.
DATABASE_URL=postgresql://dukaanhub:dukaanhub@localhost:5432/dukaanhub?schema=public

# Auth - replace both secrets before deploying (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# HTTP
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000

# Uploads (local disk; swap the service for S3/Supabase Storage in production)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Payments
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENTS_AUTO_CONFIRM=true
FREE_DELIVERY_THRESHOLD=199
DELIVERY_FEE=25
HANDLING_FEE=2

# Rate limiting (requests per window)
THROTTLE_TTL=60
THROTTLE_LIMIT=120
