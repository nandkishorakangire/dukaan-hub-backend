# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Supabase users: append ?pgbouncer=true for pooled connections.
DATABASE_URL=postgresql://dukaanhub:dukaanhub@localhost:5432/dukaanhub?schema=public

# Auth - replace both secrets before deploying (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Google/Apple sign-in (leave blank to disable the provider; env placeholders are fine locally)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Verification code delivery. When unset, codes are only returned when AUTH_EXPOSE_CODES=true.
# AUTH_EXPOSE_CODES defaults to true outside production; set it explicitly in every environment.
AUTH_EXPOSE_CODES=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30

# SMTP email delivery for verification codes (SMTP_HOST + SMTP_FROM enable sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DukaanHub <no-reply@dukaanhub.local>

# Fast2SMS (route=q) for verification OTPs; leave blank to skip SMS delivery
FAST2SMS_API_KEY=

# HTTP
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:19006,http://localhost:3000,http://192.168.29.172:8081
PUBLIC_BASE_URL=http://localhost:4000

# Uploads (local disk; swap the service for S3/Supabase Storage in production)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Payments
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENTS_AUTO_CONFIRM=true
FREE_DELIVERY_THRESHOLD=199
DELIVERY_FEE=25
HANDLING_FEE=2

# Rate limiting (requests per window)
THROTTLE_TTL=60
THROTTLE_LIMIT=120
